# Wewnętrzne materiały robocze (zlecenia, zapisy źródeł) — nie część produktu
ProjektyLLm/

# Zmienne srodowiskowe. Repo jest PUBLICZNE, a GitHub jest przeczesywany przez
# boty pod katem kluczy API w ciagu minut od commita — plik nie moze tu trafic.
# Sam .env zostaje na dysku i lokalny build dziala normalnie.
#
# WZORZEC, NIE LISTA. Do 10 wrzesnia 2026 stala tu wyliczanka szesciu nazw:
# .env, .env.local, .env.deploy, .env.import, .env.stary-projekt.bak i wzorzec
# .env.*.local. Wyliczanka ma te sama wade, co slowniki skanerow, ktore nas
# omiataja: chroni tylko te nazwy, ktore ktos wczesniej pomyslal. Sprawdzone
# tego dnia — .envStary, .env.bak i .env~ NIE byly ignorowane, a repo jest
# publiczne. Zaden z nich akurat nie istnial, ale to byl przypadek, nie system.
#
# git rozumie gwiazdke, wiec zamiast dopisywac siodma nazwe, dopisujemy wzorzec.
# Wyjatek na koncu: przyklad bez wartosci ma zostac widoczny.
.env*
!.env.deploy.przyklad
# Klucz do uruchamiania wysylki. Trzymany w pliku, zeby nie przechodzil przez
# konsole, historie polecen i zrzuty ekranu - tak juz raz wyciekl.
.klucz-wysylki

# Pliki eksportu z Lovable: konta, ewidencja RHD, faktury i pliki uzytkownikow.
# REPO JEST PUBLICZNE - te dane nie moga trafic do commita pod zadnym pozorem.
export/
*.export.json

# Cache Pythona ze skryptow generujacych
__pycache__/
*.pyc

# Lokalny stan wranglera (cache builda i podgladu) - nie do repo
.wrangler

# Eksporty z GSC / Bing / Senuto i raport z ich analizy - repo jest publiczne,
# a to pelna mapa fraz i ruchu serwisu. Skrypt i wybrane pytania zostaja w repo,
# surowe dane leza lokalnie u Marka (patrz data/pytania/README.md).
data/pytania/zrodla/
data/pytania/kandydaci-*.md

# Katalog roboczy Claude Code. REPO JEST PUBLICZNE, a 3 wrzesnia 2026 lezala tu
# CALA druga kopia repozytorium (.claude/worktrees/) — jedno "git add -A"
# wciagneloby ja do publicznego repo. Ignorujemy zawartosc, ale zostawiamy
# launch.json: to konfiguracja serwera deweloperskiego, wspolna dla projektu,
# a nie ustawienie konkretnej maszyny.
.claude/*
!.claude/launch.json

# Prywatny katalog roboczy Marka - rzeczy trzymane pod reka w projekcie,
# zeby ich nie szukac. Straznik przed commitem i tak zablokowalby kazdy nowy
# katalog najwyzszego poziomu, ale bez tego wpisu `git status` szumi.
Moje/

# Spis projektu - lokalny zapis stanu katalogu, do wykrywania zmian, ktorych
# nie zrobil Claude. Zawiera sciezki plikow prywatnych (skroty, nie tresc),
# wiec nie moze trafic do publicznego repo. Zakladany przez `npm run spis`.
.spis-projektu.json
