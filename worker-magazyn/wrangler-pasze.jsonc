{
  // ===========================================================================
  //  mojapasza.com/mcp: łącznik MCP z narzędziami paszowymi (od 26.10.2026)
  //
  //  Ten sam kod co dane.mojaserowarnia.pl (worker-magazyn/src), inny wariant:
  //  "define" niżej przełącza src/serwis.js na mojapasza (tylko pasze i dodatki,
  //  adresy mojapasza.com, pomiar z serwer = mojapasza). Bez własnej domeny:
  //  Worker mojapasza.com (pasze/wrangler.jsonc) przekazuje mu /mcp i /mcp/*
  //  przez wiązanie usług, więc ten Worker nie ma tras ani adresu *.workers.dev.
  //
  //  Lokalnie (z głównego katalogu repo):
  //    npx wrangler dev -c worker-magazyn/wrangler-pasze.jsonc --port 8789
  //  Wdrożenie (tylko z głównego katalogu, jeden wątek naraz, PRZED pierwszym
  //  wdrożeniem mojapasza z wiązaniem MCP):
  //    npm run deploy:magazyn -- --pasze
  // ===========================================================================
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "mojapasza-mcp",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",

  "define": { "__SERWIS__": "\"mojapasza\"" },

  "workers_dev": false,
  "preview_urls": false,

  // Te same limity co w Serowarni, ale osobne liczniki (namespace_id unikalny w koncie).
  "ratelimits": [
    { "name": "LIMIT_ADRES", "namespace_id": "1104", "simple": { "limit": 30, "period": 60 } },
    { "name": "LIMIT_CALOSC", "namespace_id": "1105", "simple": { "limit": 600, "period": 60 } },
    { "name": "LIMIT_KLUCZ", "namespace_id": "1106", "simple": { "limit": 300, "period": 60 } }
  ],

  // Sekrety jak w wrangler.jsonc, osobno dla tego Workera:
  //   npx wrangler secret put SUPABASE_SERVICE_KEY -c worker-magazyn/wrangler-pasze.jsonc
  //   (opcjonalnie) WLASNY_ZNACZNIK i KLUCZE_APLIKACJI.
  "vars": {
    "SUPABASE_URL": "https://hsgxmbhunclhgzumafrk.supabase.co"
  },

  "observability": { "enabled": true }
}
