{
  // ===========================================================================
  //  mojaserowarnia.pl — hosting na Cloudflare Workers (zastępuje home.pl)
  //
  //  DLACZEGO WORKER, A NIE SAME STATIC ASSETS: serwis ma dwie warstwy treści —
  //  aplikację React dla ludzi i statyczne mirrory public/**.html dla botów.
  //  Na Apache rozdzielał je .htaccess (reguły po User-Agent, DirectoryIndex,
  //  prawdziwe 404). Sam hosting plików tego nie odtworzy, więc logika z
  //  .htaccess (zachowany jako docs/htaccess-home-pl.txt) przeniesiona jest
  //  1:1 do worker/index.js.
  // ===========================================================================
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mojaserowarnia",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",

    // "none" = ścieżka trafia wyłącznie w plik o dokładnie tej nazwie.
    // KLUCZOWE dla dwuwarstwowości: przy domyślnym "auto-trailing-slash"
    // żądanie /przepisy/mozzarella dostałoby /przepisy/mozzarella.html, czyli
    // mirror dla botów trafiłby do KAŻDEGO człowieka zamiast aplikacji React.
    "html_handling": "none",

    // "none" = brak dopasowania spada do Workera (nie: "single-page-application").
    // Gdyby SPA-fallback robiła warstwa assetów, worker/index.js NIGDY by się nie
    // uruchomił — a to on serwuje mirrory botom i zwraca prawdziwe 404.
    "not_found_handling": "none",

    // Wylacznie dla tej jednej sciezki worker dostaje zadanie przed warstwa
    // assetow. Powod: adresy podgladowe *.workers.dev serwuja pelna kopie
    // serwisu, a robots.txt jest pierwsza rzecza, o ktora pyta robot. Bez
    // tego plik z repo (Allow: /) serwowalby sie takze tam i kopia mogla by
    // trafic do indeksu jako duplikat calej domeny.
    "run_worker_first": ["/robots.txt"]
  },

  // Domena wlasciwa.
  //
  // Apex celowo jako TRASA, nie custom_domain: custom_domain zada usuniecia
  // rekordu A wskazujacego na home.pl (blad 100117), a trasa nakłada sie na
  // istniejacy rekord. Worker obsluguje wtedy 100% zadan i nigdy nie odpytuje
  // serwera zrodlowego, wiec rekord moze zostac - jest darmowa droga odwrotu
  // (skasowanie trasy = natychmiastowy powrot na home.pl) i nie ma ani sekundy
  // przerwy przy przelaczaniu. Gdy home.pl zgasnie, rekord bedzie wskazywac
  // martwy adres, do ktorego i tak nic nie puka.
  //
  // www przeciwnie - jest custom_domain, bo tam rekordu A juz nie ma. Istnieje
  // tylko po to, zeby worker mogl przekierowac na adres bez www (krok 1).
  "routes": [
    { "pattern": "mojaserowarnia.pl/*", "zone_name": "mojaserowarnia.pl" },
    { "pattern": "www.mojaserowarnia.pl", "custom_domain": true }
  ],

  "observability": { "enabled": true }
}
