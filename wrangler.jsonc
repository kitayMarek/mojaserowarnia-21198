{
  // ===========================================================================
  //  mojaserowarnia.pl — hosting na Cloudflare Workers (zastępuje home.pl)
  //
  //  DLACZEGO WORKER, A NIE SAME STATIC ASSETS: serwis ma dwie warstwy treści —
  //  aplikację React dla ludzi i statyczne mirrory public/**.html dla botów.
  //  Na Apache rozdzielał je .htaccess (reguły po User-Agent, DirectoryIndex,
  //  prawdziwe 404). Sam hosting plików tego nie odtworzy, więc logika z
  //  .htaccess (zachowany jako docs/htaccess-home-pl.txt) przeniesiona jest
  //  1:1 do worker/index.js.
  // ===========================================================================
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mojaserowarnia",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",

    // "none" = ścieżka trafia wyłącznie w plik o dokładnie tej nazwie.
    // KLUCZOWE dla dwuwarstwowości: przy domyślnym "auto-trailing-slash"
    // żądanie /przepisy/mozzarella dostałoby /przepisy/mozzarella.html, czyli
    // mirror dla botów trafiłby do KAŻDEGO człowieka zamiast aplikacji React.
    "html_handling": "none",

    // "none" = brak dopasowania spada do Workera (nie: "single-page-application").
    // Gdyby SPA-fallback robiła warstwa assetów, worker/index.js NIGDY by się nie
    // uruchomił — a to on serwuje mirrory botom i zwraca prawdziwe 404.
    "not_found_handling": "none",

    // Trzy sciezki, dla ktorych worker dostaje zadanie PRZED warstwa assetow.
    //
    // /robots.txt — adresy podgladowe *.workers.dev serwuja pelna kopie serwisu,
    //   a robots.txt jest pierwsza rzecza, o ktora pyta robot. Bez tego plik
    //   z repo (Allow: /) serwowalby sie takze tam i kopia mogla by trafic do
    //   indeksu jako duplikat calej domeny.
    //
    // /boty-ai.html — to NIE jest gotowy dokument, tylko szablon z zetonami
    //   {{...}}, ktore worker podstawia z widokow pub_*. Warstwa assetow
    //   odpowiada wczesniej niz worker, wiec bez tego wpisu strona poszlaby
    //   w swiat z widocznym {{proc_calosci}}.
    //
    // /bot-stats.json — pliku nie ma na dysku, sklada go worker z tych samych
    //   danych. Wpis jest tu dla jawnosci: obie sciezki strony /boty-ai stoja
    //   obok siebie, zamiast jednej w konfiguracji i drugiej ukrytej w kodzie.
    // /en/ai-bots.html — to samo co /boty-ai.html, tylko po angielsku: rowniez
    //   szablon z zetonami, wiec bez tego wpisu poszlaby w swiat surowa.
    // /sitemap.xml i /llms.txt — DOPISANE 7.09.2026, zeby dalo sie je ZMIERZYC.
    // Oba fizycznie leza w dist/, wiec warstwa assetow oddawala je bez
    // uruchamiania workera i zapiszWizyteBota nigdy sie nie wykonywalo.
    // Skutek: licznik pokazywal dla nich twarde zero, a my odczytalismy je jako
    // "nikt nie pobiera". Bledny wniosek — nie mielismy jak zobaczyc.
    //
    // Kosztowalo to jeden falszywy wniosek o llms.txt ("konwencja bez pokrycia")
    // i pol dnia podejrzen, ze sitemapa jest zle zgloszona.
    "run_worker_first": ["/*.html", "/.well-known/traffic-advice", "/robots.txt", "/boty-ai.html", "/en/ai-bots.html", "/bot-stats.json", "/sitemap.xml", "/llms.txt", "/proba/dane.xml", "/proba/dane.txt", "/proba/dane.json", "/proba/mapa.xml", "/favicon.ico", "/og-image.png", "/og-image.jpg"]
  },

  // Domena wlasciwa.
  //
  // Apex celowo jako TRASA, nie custom_domain: custom_domain zada usuniecia
  // rekordu A wskazujacego na home.pl (blad 100117), a trasa nakłada sie na
  // istniejacy rekord. Worker obsluguje wtedy 100% zadan i nigdy nie odpytuje
  // serwera zrodlowego, wiec rekord moze zostac - jest darmowa droga odwrotu
  // (skasowanie trasy = natychmiastowy powrot na home.pl) i nie ma ani sekundy
  // przerwy przy przelaczaniu. Gdy home.pl zgasnie, rekord bedzie wskazywac
  // martwy adres, do ktorego i tak nic nie puka.
  //
  // www przeciwnie - jest custom_domain, bo tam rekordu A juz nie ma. Istnieje
  // tylko po to, zeby worker mogl przekierowac na adres bez www (krok 1).
  "routes": [
    { "pattern": "mojaserowarnia.pl/*", "zone_name": "mojaserowarnia.pl" },
    { "pattern": "www.mojaserowarnia.pl", "custom_domain": true }
  ],

  // Adres projektu Supabase — potrzebny licznikowi wizyt botów
  // (worker/wizyty-botow.js). NIE jest sekretem: ten sam adres siedzi jawnie
  // w buildzie aplikacji React. Sekretem jest wyłącznie klucz service_role,
  // ustawiany osobno przez `npx wrangler secret put SUPABASE_SERVICE_KEY`
  // i nigdy nietrzymany w repo (repo jest publiczne).
  "vars": {
    "SUPABASE_URL": "https://hsgxmbhunclhgzumafrk.supabase.co"
  },

  "observability": { "enabled": true }
}
